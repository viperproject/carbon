// Chains of lets whose variables are used several times: translating and verifying them must take
// time linear in their length.

function q(i: Int): Int
function f(a: Int, b: Int): Int
function p(i: Int): Bool

field val: Int

function h(x: Ref): Int
  requires let a0 == (q(0)) in let a1 == (f(a0, a0)) in let a2 == (f(a1, a1)) in let a3 == (f(a2, a2)) in let a4 == (f(a3, a3)) in let a5 == (f(a4, a4)) in let a6 == (f(a5, a5)) in let a7 == (f(a6, a6)) in let a8 == (f(a7, a7)) in let a9 == (f(a8, a8)) in let a10 == (f(a9, a9)) in let a11 == (f(a10, a10)) in let a12 == (f(a11, a11)) in let a13 == (f(a12, a12)) in let a14 == (f(a13, a13)) in let a15 == (f(a14, a14)) in let a16 == (f(a15, a15)) in let a17 == (f(a16, a16)) in let a18 == (f(a17, a17)) in let a19 == (f(a18, a18)) in let a20 == (f(a19, a19)) in let a21 == (f(a20, a20)) in let a22 == (f(a21, a21)) in let a23 == (f(a22, a22)) in let a24 == (f(a23, a23)) in let a25 == (f(a24, a24)) in let a26 == (f(a25, a25)) in let a27 == (f(a26, a26)) in let a28 == (f(a27, a27)) in let a29 == (f(a28, a28)) in let a30 == (f(a29, a29)) in p(a30)

predicate P(x: Ref) { acc(x.val) && let a0 == (q(0)) in let a1 == (f(a0, a0)) in let a2 == (f(a1, a1)) in let a3 == (f(a2, a2)) in let a4 == (f(a3, a3)) in let a5 == (f(a4, a4)) in let a6 == (f(a5, a5)) in let a7 == (f(a6, a6)) in let a8 == (f(a7, a7)) in let a9 == (f(a8, a8)) in let a10 == (f(a9, a9)) in let a11 == (f(a10, a10)) in let a12 == (f(a11, a11)) in let a13 == (f(a12, a12)) in let a14 == (f(a13, a13)) in let a15 == (f(a14, a14)) in let a16 == (f(a15, a15)) in let a17 == (f(a16, a16)) in let a18 == (f(a17, a17)) in let a19 == (f(a18, a18)) in let a20 == (f(a19, a19)) in let a21 == (f(a20, a20)) in let a22 == (f(a21, a21)) in let a23 == (f(a22, a22)) in let a24 == (f(a23, a23)) in let a25 == (f(a24, a24)) in let a26 == (f(a25, a25)) in let a27 == (f(a26, a26)) in let a28 == (f(a27, a27)) in let a29 == (f(a28, a28)) in let a30 == (f(a29, a29)) in p(a30) }

method unfoldP(x: Ref)
  requires P(x)
{
  unfold P(x)
  assert let a0 == (q(0)) in let a1 == (f(a0, a0)) in let a2 == (f(a1, a1)) in let a3 == (f(a2, a2)) in let a4 == (f(a3, a3)) in let a5 == (f(a4, a4)) in let a6 == (f(a5, a5)) in let a7 == (f(a6, a6)) in let a8 == (f(a7, a7)) in let a9 == (f(a8, a8)) in let a10 == (f(a9, a9)) in let a11 == (f(a10, a10)) in let a12 == (f(a11, a11)) in let a13 == (f(a12, a12)) in let a14 == (f(a13, a13)) in let a15 == (f(a14, a14)) in let a16 == (f(a15, a15)) in let a17 == (f(a16, a16)) in let a18 == (f(a17, a17)) in let a19 == (f(a18, a18)) in let a20 == (f(a19, a19)) in let a21 == (f(a20, a20)) in let a22 == (f(a21, a21)) in let a23 == (f(a22, a22)) in let a24 == (f(a23, a23)) in let a25 == (f(a24, a24)) in let a26 == (f(a25, a25)) in let a27 == (f(a26, a26)) in let a28 == (f(a27, a27)) in let a29 == (f(a28, a28)) in let a30 == (f(a29, a29)) in p(a30)
}

function g(i: Int): Bool
{ let a0 == (q(i)) in let a1 == (f(a0, a0)) in let a2 == (f(a1, a1)) in let a3 == (f(a2, a2)) in let a4 == (f(a3, a3)) in let a5 == (f(a4, a4)) in let a6 == (f(a5, a5)) in let a7 == (f(a6, a6)) in let a8 == (f(a7, a7)) in let a9 == (f(a8, a8)) in let a10 == (f(a9, a9)) in let a11 == (f(a10, a10)) in let a12 == (f(a11, a11)) in let a13 == (f(a12, a12)) in let a14 == (f(a13, a13)) in let a15 == (f(a14, a14)) in let a16 == (f(a15, a15)) in let a17 == (f(a16, a16)) in let a18 == (f(a17, a17)) in let a19 == (f(a18, a18)) in let a20 == (f(a19, a19)) in let a21 == (f(a20, a20)) in let a22 == (f(a21, a21)) in let a23 == (f(a22, a22)) in let a24 == (f(a23, a23)) in let a25 == (f(a24, a24)) in let a26 == (f(a25, a25)) in let a27 == (f(a26, a26)) in let a28 == (f(a27, a27)) in let a29 == (f(a28, a28)) in let a30 == (f(a29, a29)) in p(a30) }

method instantiate()
  requires forall i: Int :: { q(i) } let a0 == (q(i)) in let a1 == (f(a0, a0)) in let a2 == (f(a1, a1)) in let a3 == (f(a2, a2)) in let a4 == (f(a3, a3)) in let a5 == (f(a4, a4)) in let a6 == (f(a5, a5)) in let a7 == (f(a6, a6)) in let a8 == (f(a7, a7)) in let a9 == (f(a8, a8)) in let a10 == (f(a9, a9)) in let a11 == (f(a10, a10)) in let a12 == (f(a11, a11)) in let a13 == (f(a12, a12)) in let a14 == (f(a13, a13)) in let a15 == (f(a14, a14)) in let a16 == (f(a15, a15)) in let a17 == (f(a16, a16)) in let a18 == (f(a17, a17)) in let a19 == (f(a18, a18)) in let a20 == (f(a19, a19)) in let a21 == (f(a20, a20)) in let a22 == (f(a21, a21)) in let a23 == (f(a22, a22)) in let a24 == (f(a23, a23)) in let a25 == (f(a24, a24)) in let a26 == (f(a25, a25)) in let a27 == (f(a26, a26)) in let a28 == (f(a27, a27)) in let a29 == (f(a28, a28)) in let a30 == (f(a29, a29)) in p(a30)
{
  assert let a0 == (q(3)) in let a1 == (f(a0, a0)) in let a2 == (f(a1, a1)) in let a3 == (f(a2, a2)) in let a4 == (f(a3, a3)) in let a5 == (f(a4, a4)) in let a6 == (f(a5, a5)) in let a7 == (f(a6, a6)) in let a8 == (f(a7, a7)) in let a9 == (f(a8, a8)) in let a10 == (f(a9, a9)) in let a11 == (f(a10, a10)) in let a12 == (f(a11, a11)) in let a13 == (f(a12, a12)) in let a14 == (f(a13, a13)) in let a15 == (f(a14, a14)) in let a16 == (f(a15, a15)) in let a17 == (f(a16, a16)) in let a18 == (f(a17, a17)) in let a19 == (f(a18, a18)) in let a20 == (f(a19, a19)) in let a21 == (f(a20, a20)) in let a22 == (f(a21, a21)) in let a23 == (f(a22, a22)) in let a24 == (f(a23, a23)) in let a25 == (f(a24, a24)) in let a26 == (f(a25, a25)) in let a27 == (f(a26, a26)) in let a28 == (f(a27, a27)) in let a29 == (f(a28, a28)) in let a30 == (f(a29, a29)) in p(a30)
}

method check()
  requires forall i: Int :: { q(i) } let a0 == (q(i)) in let a1 == (f(a0, a0)) in let a2 == (f(a1, a1)) in let a3 == (f(a2, a2)) in let a4 == (f(a3, a3)) in let a5 == (f(a4, a4)) in let a6 == (f(a5, a5)) in let a7 == (f(a6, a6)) in let a8 == (f(a7, a7)) in let a9 == (f(a8, a8)) in let a10 == (f(a9, a9)) in let a11 == (f(a10, a10)) in let a12 == (f(a11, a11)) in let a13 == (f(a12, a12)) in let a14 == (f(a13, a13)) in let a15 == (f(a14, a14)) in let a16 == (f(a15, a15)) in let a17 == (f(a16, a16)) in let a18 == (f(a17, a17)) in let a19 == (f(a18, a18)) in let a20 == (f(a19, a19)) in let a21 == (f(a20, a20)) in let a22 == (f(a21, a21)) in let a23 == (f(a22, a22)) in let a24 == (f(a23, a23)) in let a25 == (f(a24, a24)) in let a26 == (f(a25, a25)) in let a27 == (f(a26, a26)) in let a28 == (f(a27, a27)) in let a29 == (f(a28, a28)) in let a30 == (f(a29, a29)) in p(a30)
  ensures forall i: Int :: { q(i) } let a0 == (q(i)) in let a1 == (f(a0, a0)) in let a2 == (f(a1, a1)) in let a3 == (f(a2, a2)) in let a4 == (f(a3, a3)) in let a5 == (f(a4, a4)) in let a6 == (f(a5, a5)) in let a7 == (f(a6, a6)) in let a8 == (f(a7, a7)) in let a9 == (f(a8, a8)) in let a10 == (f(a9, a9)) in let a11 == (f(a10, a10)) in let a12 == (f(a11, a11)) in let a13 == (f(a12, a12)) in let a14 == (f(a13, a13)) in let a15 == (f(a14, a14)) in let a16 == (f(a15, a15)) in let a17 == (f(a16, a16)) in let a18 == (f(a17, a17)) in let a19 == (f(a18, a18)) in let a20 == (f(a19, a19)) in let a21 == (f(a20, a20)) in let a22 == (f(a21, a21)) in let a23 == (f(a22, a22)) in let a24 == (f(a23, a23)) in let a25 == (f(a24, a24)) in let a26 == (f(a25, a25)) in let a27 == (f(a26, a26)) in let a28 == (f(a27, a27)) in let a29 == (f(a28, a28)) in let a30 == (f(a29, a29)) in p(a30)
{}

method inFunction()
  requires forall i: Int :: { q(i) } g(i)
{
  assert let a0 == (q(3)) in let a1 == (f(a0, a0)) in let a2 == (f(a1, a1)) in let a3 == (f(a2, a2)) in let a4 == (f(a3, a3)) in let a5 == (f(a4, a4)) in let a6 == (f(a5, a5)) in let a7 == (f(a6, a6)) in let a8 == (f(a7, a7)) in let a9 == (f(a8, a8)) in let a10 == (f(a9, a9)) in let a11 == (f(a10, a10)) in let a12 == (f(a11, a11)) in let a13 == (f(a12, a12)) in let a14 == (f(a13, a13)) in let a15 == (f(a14, a14)) in let a16 == (f(a15, a15)) in let a17 == (f(a16, a16)) in let a18 == (f(a17, a17)) in let a19 == (f(a18, a18)) in let a20 == (f(a19, a19)) in let a21 == (f(a20, a20)) in let a22 == (f(a21, a21)) in let a23 == (f(a22, a22)) in let a24 == (f(a23, a23)) in let a25 == (f(a24, a24)) in let a26 == (f(a25, a25)) in let a27 == (f(a26, a26)) in let a28 == (f(a27, a27)) in let a29 == (f(a28, a28)) in let a30 == (f(a29, a29)) in p(a30)
}

// Triggers derived from receivers that contain lets
method qpReceiver(s: Seq[Ref])
  requires forall i: Int, k: Int :: 0 <= i && i < k && k < |s| ==> s[i] != s[k]
  requires forall i: Int :: 0 <= i && i < |s| ==> acc((let j == (i) in s[j]).val)
  requires |s| > 2
{
  s[1].val := 3
  assert s[1].val == 3
}

method fail()
  requires forall i: Int :: { q(i) } let a0 == (q(i)) in let a1 == (f(a0, a0)) in let a2 == (f(a1, a1)) in let a3 == (f(a2, a2)) in let a4 == (f(a3, a3)) in let a5 == (f(a4, a4)) in let a6 == (f(a5, a5)) in let a7 == (f(a6, a6)) in let a8 == (f(a7, a7)) in let a9 == (f(a8, a8)) in let a10 == (f(a9, a9)) in let a11 == (f(a10, a10)) in let a12 == (f(a11, a11)) in let a13 == (f(a12, a12)) in let a14 == (f(a13, a13)) in let a15 == (f(a14, a14)) in let a16 == (f(a15, a15)) in let a17 == (f(a16, a16)) in let a18 == (f(a17, a17)) in let a19 == (f(a18, a18)) in let a20 == (f(a19, a19)) in let a21 == (f(a20, a20)) in let a22 == (f(a21, a21)) in let a23 == (f(a22, a22)) in let a24 == (f(a23, a23)) in let a25 == (f(a24, a24)) in let a26 == (f(a25, a25)) in let a27 == (f(a26, a26)) in let a28 == (f(a27, a27)) in let a29 == (f(a28, a28)) in let a30 == (f(a29, a29)) in p(a30)
{
  //:: ExpectedOutput(assert.failed:assertion.false)
  assert !(let a0 == (q(3)) in let a1 == (f(a0, a0)) in let a2 == (f(a1, a1)) in let a3 == (f(a2, a2)) in let a4 == (f(a3, a3)) in let a5 == (f(a4, a4)) in let a6 == (f(a5, a5)) in let a7 == (f(a6, a6)) in let a8 == (f(a7, a7)) in let a9 == (f(a8, a8)) in let a10 == (f(a9, a9)) in let a11 == (f(a10, a10)) in let a12 == (f(a11, a11)) in let a13 == (f(a12, a12)) in let a14 == (f(a13, a13)) in let a15 == (f(a14, a14)) in let a16 == (f(a15, a15)) in let a17 == (f(a16, a16)) in let a18 == (f(a17, a17)) in let a19 == (f(a18, a18)) in let a20 == (f(a19, a19)) in let a21 == (f(a20, a20)) in let a22 == (f(a21, a21)) in let a23 == (f(a22, a22)) in let a24 == (f(a23, a23)) in let a25 == (f(a24, a24)) in let a26 == (f(a25, a25)) in let a27 == (f(a26, a26)) in let a28 == (f(a27, a27)) in let a29 == (f(a28, a28)) in let a30 == (f(a29, a29)) in p(a30))
}
